#!/usr/bin/env bash
# 敏感真值内容扫描 v5：真值一律占位符化（对照 README），命中即拒推
# 具体真值（含称谓）base64 内嵌，本文件零真值明文；排除自身行防自锁
_B64="aG9tZS5uYW5zaGFyay5jY3d1LmNjIDEyMzQ1NiBib3NzQHZhdWx0IDJBRjcgRzMyMjAgaTctNDc5MCBpNS00NTcwIOiAgeadvw=="
_SPEC=$(echo "$_B64" | base64 -d)
_RANGES='192\.168\.[0-9]+\.[0-9]+|10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]+\.[0-9]+'
_GEN='[a-z0-9-]+\.tail[0-9a-f]{4,}\.ts\.net|/home/[a-z]+/'
ESCAPED=$(echo "$_SPEC" | tr ' ' '\n' | sed 's/[.[*+?(^)$]\\/&/g' | paste -sd '|')
BLOCK="$ESCAPED|$_RANGES|$_GEN"
hits=$(git grep -n -I -E "$BLOCK" HEAD -- 2>/dev/null | grep -v 'hooks/pre-push')
if [ -n "$hits" ]; then
  echo "✘ 检出敏感真值，禁止推送（请改用占位符，真实值存本地 _local/）："
  echo "$hits" | head -10
  exit 1
fi
if [ -x "$HOME/.hermes/tools/git-conventions/check-secrets.sh" ]; then
  "$HOME/.hermes/tools/git-conventions/check-secrets.sh" || exit 1
fi
exit 0
